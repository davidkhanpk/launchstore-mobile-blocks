    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@shopify/restyle": "^2.4.5",
    "@types/react": "~19.2.3",
    "nativewind": "^4.2.7",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2"
  },
  "private": true
}
